# 저장소에는 항상 LF로 저장하고, 체크아웃할 때도 LF를 유지한다.
# (Windows의 core.autocrlf=true 환경에서 CRLF로 풀리면 .prettierrc의 endOfLine: "lf" 때문에
#  코드가 멀쩡해도 prettier --check가 전체 파일에서 실패한다.)
* text=auto eol=lf

# 윈도우 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리는 변환 대상에서 제외
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.jar binary
*.keystore binary
